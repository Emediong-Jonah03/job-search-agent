APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-value
DASHBOARD_PASSWORD=
DATABASE_URL=postgresql+psycopg://jobs:jobs@db:5432/jobs
REDIS_URL=redis://redis:6379/0
PROFILE_PATH=/app/profile.yaml
ARTIFACTS_PATH=/app/private-artifacts
LOG_LEVEL=INFO
DISCOVERY_BOARDS=remoteok;remotive;jobicy;weworkremotely
FOLLOW_UP_DAYS=7
VERIFICATION_VERIFIED_THRESHOLD=70
VERIFICATION_SUSPICIOUS_RISK_THRESHOLD=40
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_AUTO_PRIORITY=xai,gemini,openai,claude,groq
LLM_TIMEOUT_SECONDS=45
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
CLAUDE_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
XAI_MODEL=grok-4.7
ANTHROPIC_API_VERSION=2023-06-01

