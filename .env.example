APP_ENV=development
APP_SECRET_KEY=
DASHBOARD_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=postgresql+psycopg://jobs:replace-me@db:5432/jobs
REDIS_URL=redis://:replace-me@redis:6379/0
PROFILE_PATH=/app/profile.yaml
ARTIFACTS_PATH=/app/private-artifacts
LOG_LEVEL=INFO
FORWARDED_ALLOW_IPS=127.0.0.1,::1
DISCOVERY_BOARDS=remoteok;remotive;jobicy;weworkremotely
FOLLOW_UP_DAYS=7
VERIFICATION_VERIFIED_THRESHOLD=70
VERIFICATION_SUSPICIOUS_RISK_THRESHOLD=40
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_AUTO_PRIORITY=xai,gemini,openai,claude,groq
LLM_TIMEOUT_SECONDS=45
OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=xxxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxxxxxxxx
GROQ_API_KEY=xxxxxxxxxxxxx
XAI_API_KEY=xxxxxxxxxxxx
OPENAI_MODEL=xxxxxxxx
CLAUDE_MODEL=xxxxxxxx
GEMINI_MODEL=xxxxxxxx
GROQ_MODEL=xxxxxxxx
XAI_MODEL=xxxxxxxx
ANTHROPIC_API_VERSION=2023-06-01

